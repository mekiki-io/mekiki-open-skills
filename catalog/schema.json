{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mekiki skills category",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "skills"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 300 },
    "skills": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/key" },
      "additionalProperties": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "level"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "level": { "enum": ["junior", "middle", "senior"] },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        },
        "related": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        }
      }
    }
  }
}
